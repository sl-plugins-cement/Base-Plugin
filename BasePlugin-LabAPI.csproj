<Project Sdk="Microsoft.NET.Sdk">

  <!-- 在 scpsl-plugins 元仓库中构建时，从共享的依赖目录取引用；单独克隆时使用下方的默认路径。 -->
  <Import Project="$(SCPSL_METAREPO)\build\scpsl-deps.props" Condition="'$(SCPSL_METAREPO)' != '' And Exists('$(SCPSL_METAREPO)\build\scpsl-deps.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BasePlugin_LabAPI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>

    <!-- 默认沿用仓库原来的 ..\Resources 目录布局，可用 -p:SCP_SL_MANAGED=... 与 -p:HintServiceMeowDll=... 覆盖。 -->
    <SCP_SL_MANAGED Condition="'$(SCP_SL_MANAGED)' == ''">$(MSBuildProjectDirectory)\..\Resources\Managed</SCP_SL_MANAGED>
    <HintServiceMeowDll Condition="'$(HintServiceMeowDll)' == ''">$(MSBuildProjectDirectory)\..\Resources\HintServiceMeow-LabAPI.dll</HintServiceMeowDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(SCP_SL_MANAGED)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(SCP_SL_MANAGED)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(SCP_SL_MANAGED)\CommandSystem.Core.dll" Private="false" />
    <Reference Include="Pooling" HintPath="$(SCP_SL_MANAGED)\Pooling.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(SCP_SL_MANAGED)\Mirror.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SCP_SL_MANAGED)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="YamlDotNet" HintPath="$(SCP_SL_MANAGED)\YamlDotNet.dll" Private="false" />
    <Reference Include="HintServiceMeow" HintPath="$(HintServiceMeowDll)" Private="false" />
  </ItemGroup>

</Project>
